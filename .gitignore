# =====================================================================
# Local Code Intelligence Analyzer - .gitignore
# Visual Studio, VS Code, Rider, .NET, Windows, build, database locali,
# esportazioni, repository analizzati e segreti.
# =====================================================================

# --- Output di build .NET ---
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
[Pp]ublished/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
nuget.config.user

# --- Test e copertura ---
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# --- Visual Studio ---
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.rsuser
*.userprefs
*.VC.db
*.VC.VC.opendb
ipch/
*.ncb
*.aps
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.cr/

# --- VS Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# --- JetBrains Rider ---
.idea/
*.sln.iml

# --- Windows ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# --- macOS / Linux (contributori) ---
.DS_Store
*~
.directory

# --- File temporanei ---
*.tmp
*.temp
*.bak
*.swp
*.orig
*.rej
tmp/
temp/

# --- Database locali e indici dell'applicazione ---
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
lcia-index/
LocalCodeIntelligenceAnalyzer-data/

# --- Esportazioni prodotte dall'applicazione ---
exports/
*.lcia-export.*
*-full-*.part*.txt
*-full-*.part*.md

# --- Repository analizzati / sorgenti di terzi (mai nel repository del prodotto) ---
analyzed-repos/
workspace/
third-party-sources/

# --- Segreti e credenziali ---
.env
.env.*
!.env.example
secrets.json
*.pfx
*.p12
*.pem
*.key
*.snk
*.cer
*.crt
*.jks
*.keystore
*.publishsettings
*.pubxml.user
*.azurePubxml
appsettings.*.local.json
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.gpg
*.asc

# --- Log ---
*.log

# --- Node (strumenti eventuali) ---
node_modules/

# --- Python (strumenti eventuali) ---
__pycache__/
*.py[cod]
.venv/
