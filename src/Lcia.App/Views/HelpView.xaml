<UserControl x:Class="Lcia.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Guida" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Manuale d'uso sempre disponibile, anche senza internet. Scegli un argomento a sinistra o cerca una parola." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Indice, ricerca, scorciatoie e informazioni -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="Cerca nel manuale" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             ToolTip="Una o più parole: vengono mostrati gli argomenti che le contengono tutte" />
                    <DockPanel Margin="0,4,0,0">
                        <Button DockPanel.Dock="Right" Content="Tutto il manuale" Command="{Binding ShowWholeManualCommand}" Padding="8,2" />
                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding ProductText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AboutText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8" />
                        <TextBlock Text="Dati locali (indice, log, impostazioni)" Style="{StaticResource Muted}" FontSize="12" />
                        <TextBox Text="{Binding DataDirectory, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" FontSize="12" Margin="0,0,0,8" />
                        <WrapPanel>
                            <Button Content="Cartella dati" Command="{Binding OpenDataFolderCommand}" Margin="0,0,6,0" Padding="8,3" />
                            <Button Content="Cartella log" Command="{Binding OpenLogsFolderCommand}" Padding="8,3" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Expander DockPanel.Dock="Bottom" Header="Scorciatoie da tastiera" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Shortcuts}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Keys}" FontFamily="{StaticResource CodeFont}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <ListBox ItemsSource="{Binding Topics}" SelectedItem="{Binding SelectedTopic}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <Rectangle Width="{Binding Indent}" />
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="Transparent" />

            <!-- Contenuto dell'argomento -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                <FlowDocumentScrollViewer x:Name="Viewer" IsToolBarVisible="False" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
