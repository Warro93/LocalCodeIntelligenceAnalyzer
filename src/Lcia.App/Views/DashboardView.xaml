<UserControl x:Class="Lcia.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,16">
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Analisi interamente locale: nessun upload del codice, nessuna esecuzione del codice analizzato, repository in sola lettura."
                       Style="{StaticResource PageSubtitle}" />

            <!-- Benvenuto: visibile finché non c'è un repository indicizzato -->
            <Border Style="{StaticResource InfoCard}" Visibility="{Binding Context.HasRepository, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Benvenuto! Si parte in tre passi" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="1. Apri un progetto" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Text="Scegli una cartella, un repository Git o una soluzione .sln/.slnx. L'indicizzazione è in sola lettura e si può annullare." />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="2. Esplora e cerca" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Text="Sfoglia i file con i numeri di riga, cerca testo, simboli e riferimenti con filtri combinabili." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="3. Esporta per l'AI" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Text="Crea un dossier TXT o Markdown con struttura e codice integrale, segreti oscurati, pronto per qualsiasi AI." />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Apri cartella…" Command="{Binding Context.OpenFolderCommand}" FontWeight="SemiBold"
                                Margin="0,0,8,0" Padding="{StaticResource ButtonPadding}" />
                        <Button Content="Apri soluzione…" Command="{Binding Context.OpenSolutionCommand}" Margin="0,0,8,0" Padding="{StaticResource ButtonPadding}" />
                        <Button Content="Leggi la guida (F1)" Margin="0,0,8,0" Padding="{StaticResource ButtonPadding}"
                                Command="{Binding DataContext.ShowHelpCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding Context.HasRepository, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{Binding RepositoryTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding RepositoryDetails}" Style="{StaticResource Muted}" Margin="0,4,0,10" />
                    <WrapPanel>
                        <Button Content="Aggiorna indice" Command="{Binding Context.ReindexCommand}" FontWeight="SemiBold"
                                Margin="0,0,8,6" Padding="{StaticResource ButtonPadding}"
                                ToolTip="Rielabora solo i file nuovi o modificati (scansione incrementale, F5)" />
                        <Button Content="Reindicizza tutto" Command="{Binding Context.FullReindexCommand}" Margin="0,0,8,6" Padding="{StaticResource ButtonPadding}"
                                ToolTip="Rielabora tutti i file anche se invariati" />
                        <Button Content="Elimina indice" Command="{Binding Context.RemoveIndexCommand}" Margin="0,0,8,6" Padding="{StaticResource ButtonPadding}"
                                ToolTip="Elimina solo il database locale del repository: i sorgenti non vengono toccati" />
                        <Button Content="Aggiorna statistiche" Command="{Binding RefreshCommand}" Margin="0,0,8,6" Padding="{StaticResource ButtonPadding}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <WrapPanel>
                <Border Style="{StaticResource Card}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="File indicizzati" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding FilesText}" Style="{StaticResource CardValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" MinWidth="200">
                    <StackPanel>
                        <TextBlock Text="Righe di codice e testo" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding LinesText}" Style="{StaticResource CardValue}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" MinWidth="260">
                    <StackPanel>
                        <TextBlock Text="Simboli e relazioni (C#)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding SymbolsText}" Style="{StaticResource CardValueSmall}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" MinWidth="220">
                    <StackPanel>
                        <TextBlock Text="Soluzioni e progetti" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ProjectsText}" Style="{StaticResource CardValueSmall}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Style="{StaticResource WarningCard}" Visibility="{Binding SkippedText, Converter={StaticResource TextToVisibility}}">
                <TextBlock Text="{Binding SkippedText}" Style="{StaticResource Warning}" />
            </Border>

            <TextBlock Text="Linguaggi indicizzati" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding Languages}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" MaxHeight="280" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Linguaggio" Binding="{Binding Language}" Width="220" />
                    <DataGridTextColumn Header="File" Binding="{Binding Files}" Width="90" />
                    <DataGridTextColumn Header="Righe" Binding="{Binding Lines}" Width="120" />
                    <DataGridTextColumn Header="Dimensione" Binding="{Binding Size}" Width="110" />
                    <DataGridTextColumn Header="Livello di analisi" Binding="{Binding Support}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Ultime indicizzazioni" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding ScanRuns}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" MaxHeight="260" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Avvio" Binding="{Binding Started}" Width="150" />
                    <DataGridTextColumn Header="Esito" Binding="{Binding Status}" Width="160" />
                    <DataGridTextColumn Header="Durata" Binding="{Binding Duration}" Width="90" />
                    <DataGridTextColumn Header="Riepilogo" Binding="{Binding Summary}" Width="*" />
                </DataGrid.Columns>
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Message}" Margin="8,2,8,6" TextWrapping="Wrap" Style="{StaticResource Muted}" />
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>

            <TextBlock Text="Avvisi dell'ultima indicizzazione" Style="{StaticResource SectionTitle}" />
            <TextBox Text="{Binding WarningsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="60" MaxHeight="220"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="{StaticResource CodeFont}" FontSize="12" />

            </StackPanel>

            <TextBlock Text="Livello di supporto dichiarato per linguaggio" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding SupportMatrix}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Linguaggio / formato" Binding="{Binding Language}" Width="220" />
                    <DataGridTextColumn Header="Livello" Binding="{Binding Level}" Width="110" />
                    <DataGridTemplateColumn Header="Cosa viene analizzato" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
