<UserControl x:Class="Lcia.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,16" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="Impostazioni" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Le impostazioni e l'indice restano sul tuo PC. L'integrazione con Ollama (AI locale opzionale) arriverà nella Fase 8." />

            <!-- Aspetto: applicato subito -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Aspetto" Style="{StaticResource CardTitle}" />
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,8">
                            <TextBlock Text="Tema" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <ComboBox Width="260" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedThemeOption}"
                                      DisplayMemberPath="Label" IsEnabled="{Binding IsThemeSelectable}" />
                        </StackPanel>
                        <TextBlock Text="{Binding ThemeNote}" Style="{StaticResource Muted}" VerticalAlignment="Bottom" MaxWidth="520" Margin="0,0,0,12" />
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding UseFluentTheme}" Margin="0,4,0,0"
                              Content="Stile Fluent di Windows 11 (necessario per il tema scuro; applicato al prossimo avvio dopo Salva)" />
                </StackPanel>
            </Border>

            <!-- Scansione -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Scansione e indicizzazione" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Cartelle escluse per nome (in qualsiasi posizione), separate da virgola" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding ExcludedDirectoriesText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="50"
                             AcceptsReturn="True" Margin="0,4,0,10" />
                    <TextBlock Text="Percorsi relativi esclusi (uno per riga, es. src/Legacy/Generated)" Style="{StaticResource Muted}" />
                    <TextBox Text="{Binding ExcludedPathsText, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="50"
                             AcceptsReturn="True" Margin="0,4,0,10" />

                    <WrapPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Dimensione massima per file (KB)" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Width="160" Text="{Binding MaxFileSizeKb, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="I file più grandi vengono elencati ma non indicizzati" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Text="Profondità massima cartelle" Style="{StaticResource Muted}" Margin="0,0,0,4" />
                            <TextBox Width="160" Text="{Binding MaxDepth, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,8">
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,4">
                                <Run Text="Parallelismo (core disponibili:" />
                                <Run Text="{Binding ProcessorCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBox Width="160" Text="{Binding MaxDegreeOfParallelism, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding FollowSymbolicLinks}" Margin="0,4,0,4"
                              Content="Segui collegamenti simbolici e junction (solo se puntano all'interno della cartella selezionata)" />
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,0,0,4">
                <Button Content="Salva" Command="{Binding SaveCommand}" FontWeight="SemiBold" Margin="0,0,8,0" Padding="20,5" />
                <Button Content="Ripristina predefiniti" Command="{Binding ResetDefaultsCommand}" Margin="0,0,8,0" Padding="12,5" />
                <Button Content="Apri cartella dati" Command="{Binding OpenDataFolderCommand}" Padding="12,5" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,4,0,12" />

            <!-- Dati locali -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Dati locali" Style="{StaticResource CardTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Cartella dati" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DataDirectory, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Database indice" Style="{StaticResource Muted}" Margin="0,0,0,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="File impostazioni" Style="{StaticResource Muted}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SettingsPath, Mode=OneWay}" Style="{StaticResource ReadOnlyText}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Supporto per linguaggio -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Livello di supporto per linguaggio" Style="{StaticResource CardTitle}" />
                    <DataGrid ItemsSource="{Binding SupportMatrix}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Linguaggio / formato" Binding="{Binding Language}" Width="200" />
                            <DataGridTextColumn Header="Livello" Binding="{Binding Level}" Width="110" />
                            <DataGridTemplateColumn Header="Dettaglio" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
