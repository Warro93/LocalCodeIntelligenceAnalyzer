<UserControl x:Class="Lcia.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Cerca" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Ricerca sull'indice locale con percorso e numero di riga. I filtri sono combinabili; seleziona più risultati per includerli in un'esportazione."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <!-- Query -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Grid.Column="0" FontSize="14" Padding="6,4"
                     Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Testo da cercare. Invio per avviare la ricerca.">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <ComboBox Grid.Column="1" Width="250" Margin="8,0,0,0" ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding SelectedMode}" DisplayMemberPath="Label" />
            <Button Grid.Column="2" Content="Cerca" Command="{Binding SearchCommand}" FontWeight="SemiBold" Margin="8,0,0,0" Padding="18,4" IsDefault="False"
                    ToolTip="Avvia la ricerca (Invio)" />
            <Button Grid.Column="3" Content="Annulla" Command="{Binding SearchCancelCommand}" Margin="8,0,0,0" Padding="10,4" />
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding ModeHelp}" Style="{StaticResource Muted}" Margin="0,0,0,8" />

        <!-- Filtri -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Estensioni (es. .cs, .sql)" Style="{StaticResource Muted}" />
                <TextBox Width="170" Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Il percorso contiene" Style="{StaticResource Muted}" />
                <TextBox Width="200" Text="{Binding PathFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Progetto" Style="{StaticResource Muted}" />
                <ComboBox Width="200" IsEditable="True" ItemsSource="{Binding Projects}" Text="{Binding ProjectFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding IsSymbolMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Tipo di simbolo" Style="{StaticResource Muted}" />
                <ComboBox Width="200" ItemsSource="{Binding SymbolKinds}" SelectedItem="{Binding SelectedSymbolKind}" DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6" Visibility="{Binding IsReferenceMode, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Tipo di relazione" Style="{StaticResource Muted}" />
                <ComboBox Width="220" ItemsSource="{Binding RelationKinds}" SelectedItem="{Binding SelectedRelationKind}" DisplayMemberPath="Label" />
            </StackPanel>
            <StackPanel Margin="0,0,12,6">
                <TextBlock Text="Risultati max" Style="{StaticResource Muted}" />
                <TextBox Width="90" Text="{Binding MaxResults, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <CheckBox Content="Maiuscole/minuscole" IsChecked="{Binding CaseSensitive}" VerticalAlignment="Bottom" Margin="0,0,12,10" />
        </WrapPanel>

        <!-- Risultati -->
        <DataGrid x:Name="ResultsGrid" Grid.Row="4" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenHitCommand}"
                              CommandParameter="{Binding SelectedItem, ElementName=ResultsGrid}" />
                <KeyBinding Key="Enter" Command="{Binding OpenHitCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=ResultsGrid}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="320" />
                <DataGridTextColumn Header="Riga" Binding="{Binding Line}" Width="60" />
                <DataGridTextColumn Header="Tipo" Binding="{Binding Kind}" Width="90" />
                <DataGridTemplateColumn Header="Anteprima" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource CodeFont}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Preview}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Dettaglio" Binding="{Binding Detail}" Width="260" />
                <DataGridTextColumn Header="Progetto" Binding="{Binding Project}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Apri nel visualizzatore" Command="{Binding OpenHitCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ResultsGrid}" Margin="0,0,8,0" Padding="10,4" />
                <Button Content="Aggiungi selezionati all'esportazione" Command="{Binding AddToExportCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=ResultsGrid}" Margin="0,0,8,0" Padding="10,4"
                        ToolTip="Senza selezione aggiunge i file di tutti i risultati" />
                <Button Content="Copia risultati" Command="{Binding CopyResultsCommand}" Padding="10,4" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Warning}" Style="{StaticResource Warning}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
