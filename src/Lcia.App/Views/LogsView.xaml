<UserControl x:Class="Lcia.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Log" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Diagnostica dell'applicazione. I messaggi passano dal filtro dei segreti e non contengono il contenuto dei file analizzati." />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox Width="240" ItemsSource="{Binding Levels}" SelectedItem="{Binding MinimumLevel}" DisplayMemberPath="Label" Margin="0,0,8,0" />
            <Button Content="Pulisci vista" Command="{Binding ClearViewCommand}" Margin="0,0,8,0" Padding="10,3" />
            <Button Content="Apri cartella dei log" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,8,0" Padding="10,3" />
            <TextBlock Text="{Binding LogsDirectory}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
        </WrapPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ora" Binding="{Binding Time}" Width="80" />
                <DataGridTextColumn Header="Livello" Binding="{Binding Level}" Width="100" />
                <DataGridTextColumn Header="Componente" Binding="{Binding Category}" Width="180" />
                <DataGridTemplateColumn Header="Messaggio" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
