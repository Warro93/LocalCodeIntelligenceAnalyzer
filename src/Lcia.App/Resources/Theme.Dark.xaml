<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Palette scura dell'interfaccia. Le chiavi sono le stesse nelle due palette:
         gli elementi le usano con DynamicResource e cambiano colore senza riavvio (ThemeService). -->
    <sys:String x:Key="Lcia.PaletteName">Dark</sys:String>

    <SolidColorBrush x:Key="Lcia.Text" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Lcia.TextMuted" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Lcia.Accent" Color="#60CDFF" />
    <SolidColorBrush x:Key="Lcia.AccentSubtle" Color="#2960CDFF" />
    <SolidColorBrush x:Key="Lcia.Surface" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Lcia.Card" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="Lcia.CardBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Lcia.Divider" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Lcia.Warning" Color="#FCE100" />
    <SolidColorBrush x:Key="Lcia.WarningBackground" Color="#433519" />
    <SolidColorBrush x:Key="Lcia.Error" Color="#FF99A4" />
    <SolidColorBrush x:Key="Lcia.ErrorBackground" Color="#442726" />
    <SolidColorBrush x:Key="Lcia.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Lcia.InfoBackground" Color="#1F2B38" />
    <SolidColorBrush x:Key="Lcia.CodeBackground" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Lcia.CodeForeground" Color="#D4D4D4" />
    <SolidColorBrush x:Key="Lcia.CodeLineNumbers" Color="#6E7681" />
    <SolidColorBrush x:Key="Lcia.InlineCodeBackground" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Lcia.SearchHighlight" Color="#80806000" />
</ResourceDictionary>
