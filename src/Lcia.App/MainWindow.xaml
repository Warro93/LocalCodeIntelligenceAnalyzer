<Window x:Class="Lcia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Lcia.App.ViewModels"
        xmlns:views="clr-namespace:Lcia.App.Views"
        Title="{Binding WindowTitle}"
        Width="1380" Height="880" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/lcia.ico">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExplorerViewModel}">
            <views:ExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExportViewModel}">
            <views:ExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
    </Window.Resources>

    <!-- Scorciatoie da tastiera (elencate anche nella Guida) -->
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding Context.OpenFolderCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding Context.OpenSolutionCommand}" />
        <KeyBinding Key="F5" Command="{Binding Context.ReindexCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="search" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="export" />
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding ToggleThemeCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="7" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barra superiore: prodotto, repository corrente, azioni principali -->
        <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1"
                Background="{DynamicResource Lcia.Surface}" BorderBrush="{DynamicResource Lcia.Divider}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Image Source="pack://application:,,,/Assets/lcia.png" Width="34" Height="34" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Local Code Intelligence Analyzer" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding Context.OpenFolderCommand}" FontWeight="SemiBold"
                            Margin="{StaticResource ButtonSpacing}" Padding="{StaticResource ButtonPadding}"
                            ToolTip="Indicizza una cartella locale o un repository Git, in sola lettura (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                            <TextBlock Text="Apri cartella…" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Context.OpenSolutionCommand}"
                            Margin="{StaticResource ButtonSpacing}" Padding="{StaticResource ButtonPadding}"
                            ToolTip="Indicizza la cartella di una soluzione .sln o .slnx (Ctrl+Maiusc+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                            <TextBlock Text="Apri soluzione…" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding Context.ReindexCommand}"
                            Margin="{StaticResource ButtonSpacing}" Padding="{StaticResource ButtonPadding}"
                            ToolTip="Scansione incrementale: rielabora solo i file nuovi o modificati (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" Margin="0,0,8,0" />
                            <TextBlock Text="Aggiorna indice" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowHelpCommand}" Padding="9,5" ToolTip="Guida e manuale d'uso (F1)">
                        <TextBlock Text="&#xE897;" Style="{StaticResource IconText}" FontSize="16" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Repository" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox MinWidth="300" MaxWidth="560" ItemsSource="{Binding Context.Repositories}"
                              SelectedItem="{Binding Context.CurrentRepository}" IsEnabled="{Binding Context.IsNotBusy}"
                              ToolTip="Repository già indicizzati: scegline uno per lavorarci">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RootPath}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Navigazione e contenuto -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource Lcia.Surface}" BorderBrush="{DynamicResource Lcia.Divider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,12">
                        <Button Command="{Binding ToggleThemeCommand}" ToolTip="{Binding ThemeToolTip}" ToolTipService.ShowOnDisabled="True"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ThemeGlyph}" Style="{StaticResource IconText}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding ThemeLabel}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ShortVersionText}" Style="{StaticResource Muted}" FontSize="11" Margin="4,8,0,0" />
                    </StackPanel>

                    <ListBox Margin="6,10,6,8" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,8" ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="16" Width="30" />
                                    <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl Grid.Column="1" Margin="20,16,20,10" Content="{Binding CurrentPage}" Focusable="False" />
        </Grid>

        <!-- Barra di stato -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Background="{DynamicResource Lcia.Surface}" BorderBrush="{DynamicResource Lcia.Divider}">
            <DockPanel Margin="14,5" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Run Text="Selezione per esportazione:" />
                        <Run Text="{Binding Selection.Count, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="file" />
                    </TextBlock>
                    <ProgressBar Width="220" Height="6" Minimum="0" Maximum="100" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Value="{Binding Context.ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding Context.IsProgressIndeterminate}"
                                 Visibility="{Binding Context.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Annulla" Command="{Binding Context.CancelCommand}" Padding="10,1"
                            Visibility="{Binding Context.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding Context.StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding Context.StatusText}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
