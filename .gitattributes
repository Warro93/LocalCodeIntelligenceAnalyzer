# Normalizzazione dei fine riga: LF nel repository, conversione automatica in checkout.
* text=auto

*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.slnx    text
*.props   text
*.md      text
*.sql     text
*.json    text

# Script Windows: sempre CRLF.
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binari.
*.png     binary
*.ico     binary
*.db      binary
*.sqlite  binary
*.zip     binary
