<Project>
  <!--
    Impostazioni comuni a tutti i progetti della solution.
    La versione del prodotto si cambia SOLO qui (vedi anche CHANGELOG.md).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <Version>0.2.2</Version>
    <Product>Local Code Intelligence Analyzer</Product>
    <Description>Analisi locale di repository, codice C# e SQL Server con esportazione del contesto tecnico.</Description>
    <Copyright>Copyright (c) 2026 - Local Code Intelligence Analyzer contributors</Copyright>

    <!-- Riduce le risorse localizzate copiate in output (Roslyn ne include molte). -->
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
