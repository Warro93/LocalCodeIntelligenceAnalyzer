<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Lcia.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lcia.Hosting\Lcia.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Progetto dimostrativo copiato in output come dato di test (non viene compilato). -->
    <None Include="..\..\samples\DemoShop\**\*"
          Exclude="..\..\samples\DemoShop\bin\**;..\..\samples\DemoShop\obj\**"
          LinkBase="samples\DemoShop"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- Manuale mostrato nella pagina Guida: verificato dai test del parser Markdown. -->
    <None Include="..\..\docs\USER_GUIDE.md" Link="docs\USER_GUIDE.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
